{
  "name": "eventbus-cli",
  "version": "1.0.0",
  "description": "A CLI tool for local event-driven architecture acting as a pub/sub message broker",
  "type": "module",
  "bin": {
    "eventbus": "./bin/eventbus.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "cli",
    "eventbus",
    "pubsub",
    "events",
    "sse",
    "message-broker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "better-sqlite3": "^9.4.3",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "get-port": "^6.1.2",
    "http-terminator": "^3.2.0",
    "micromatch": "^4.0.5",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
