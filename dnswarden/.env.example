# DNSWarden Configuration
# Copy to .env and adjust as needed

# Server settings
BIND_ADDRESS=0.0.0.0
DNS_PORT=53

# Upstream DNS servers
UPSTREAM_1=1.1.1.1
UPSTREAM_2=8.8.8.8

# DoH settings
DOH_ENABLED=true
DOH_URL=https://cloudflare-dns.com/dns-query

# Blocklist settings
BLOCKLIST_ENABLED=true
BLOCKLIST_DIR=/etc/dnswarden/blocklists

# Logging settings
LOG_ENABLED=true
LOG_BACKEND=sqlite
LOG_PATH=/var/lib/dnswarden/logs.db
LOG_LEVEL=info

# Security settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QPS=100
RATE_LIMIT_BURST=200

# Admin API settings
ADMIN_ENABLED=true
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080