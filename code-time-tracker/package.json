{
  "name": "code-time-tracker",
  "version": "1.0.0",
  "description": "Local desktop application that tracks active window focus time per project",
  "main": "dist/daemon/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/daemon/index.js",
    "dev": "tsx src/daemon/index.ts",
    "api": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "time-tracking",
    "productivity",
    "developer-tools",
    "focus-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "chart.js": "^4.4.0",
    "conf": "^12.0.0",
    "date-fns": "^3.3.0",
    "electron-log": "^5.1.0",
    "express": "^4.18.2",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}