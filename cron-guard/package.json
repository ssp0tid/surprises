{
  "name": "cron-guard",
  "version": "1.0.0",
  "description": "CLI Cron Expression Validator - Validate cron expressions, view next run times, and detect conflicts",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "cron-guard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cron",
    "cli",
    "validator",
    "cron-expression",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cron-parser": "^5.0.0",
    "cronstrue": "^3.0.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}